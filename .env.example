# Antigravity AI - Environment Variables Template
# Copy this file to '.env' locally and populate your credentials securely

# Cognitive Inference & Google AI Studio
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_api_key_credentials
OPENAI_API_KEY=your_openai_gpt_api_access_credential
KIEAI_API_KEY=your_kieai_creative_rendering_api_key

# Ad Channels Feedback Hooks
META_PIXEL_ID=your_meta_pixel_id_hash
META_SYSTEM_USER_TOKEN=your_meta_system_user_authentication_key
META_APP_SECRET=your_meta_webhook_app_validation_secret_token

GOOGLE_CUSTOMER_ID=your_google_ads_customer_identifier
GOOGLE_OAUTH_TOKEN=your_google_ads_api_oauth_access_token
GOOGLE_DEVELOPER_TOKEN=your_google_ads_developer_token_hash

# Google Sheets Logging API
GOOGLE_SPREADSHEET_ID=your_google_sheets_log_spreadsheet_id
GOOGLE_OAUTH_TOKEN=your_google_sheets_oauth_access_token
OPAL_TOKEN=your_opal_api_access_token_here

# Compute & Storage Layers
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/antigravity_db
VERTEX_OAUTH_TOKEN=your_vertex_oauth_access_token_here
